FROM golang:1.24-alpine AS build

WORKDIR /src
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/lingxi-api ./cmd/server

FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=build /out/lingxi-api /app/lingxi-api
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/app/lingxi-api"]
